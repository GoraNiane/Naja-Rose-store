# ==============================================================================
# NAJA STORE - PRODUCTION & ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development # 'development' | 'production' | 'test'
PORT=5000
APP_URL=http://localhost:5173 # Public Frontend URL (e.g. https://najastore.sn or https://naja-store.vercel.app)
API_URL=http://localhost:5000/api/v1 # Public Backend API URL (e.g. https://api.najastore.sn/api/v1)

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Neon Serverless PostgreSQL Cloud Database)
# ------------------------------------------------------------------------------
# Neon connection string from Neon Console:
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Must be at least 32 characters in production (e.g. openssl rand -base64 32)
JWT_SECRET=naja_store_senegal_secure_dev_jwt_secret_key_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA ASSETS (Max 7 photos per product)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. WAVE SENEGAL PAYMENT GATEWAY (Checkout sessions & HMAC Webhooks)
# ------------------------------------------------------------------------------
WAVE_API_KEY=your_wave_live_api_key
WAVE_SECRET=your_wave_secret_key
WAVE_BUSINESS_ID=your_wave_business_id
WAVE_WEBHOOK_SECRET=your_wave_webhook_signing_secret

# ------------------------------------------------------------------------------
# 6. ORANGE MONEY SENEGAL WEBPAY (OAuth2 & WebPayment Notifications)
# ------------------------------------------------------------------------------
ORANGE_MONEY_CLIENT_ID=your_orange_money_client_id
ORANGE_MONEY_CLIENT_SECRET=your_orange_money_client_secret
ORANGE_MONEY_MERCHANT_KEY=your_orange_money_merchant_key
ORANGE_MONEY_API_KEY=your_orange_money_api_key
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/dev/v1

# ------------------------------------------------------------------------------
# 7. BUSINESS & SENEGAL LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=XOF
COUNTRY_CODE=SN
STORE_NAME="NAJA STORE"
STORE_PHONE="+221770000000"
STORE_EMAIL="contact@najastore.sn"
