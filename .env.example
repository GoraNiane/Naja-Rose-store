# ==============================================================================
# NAJA STORE - PRODUCTION & ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development # 'development' | 'production' | 'test'
PORT=5000
APP_URL=http://localhost:5173 # Public Frontend URL (e.g. https://najastore.sn or https://naja-store.vercel.app)
API_URL=http://localhost:5000/api/v1 # Public Backend API URL (e.g. https://api.najastore.sn/api/v1)

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Neon Serverless PostgreSQL Cloud Database)
# ------------------------------------------------------------------------------
# Neon connection string from Neon Console:
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Must be at least 32 characters in production (e.g. openssl rand -base64 32)
JWT_SECRET=naja_store_senegal_secure_dev_jwt_secret_key_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA ASSETS (Max 7 photos per product)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. WAVE CHECKOUT DIRECT (Compte Marchand Wave Business Sénégal)
# Documentation: https://docs.wave.com/checkout & https://docs.wave.com/webhook
# API Endpoint: https://api.wave.com/v1/checkout/sessions
# Webhook Endpoint: https://api.najastore.sn/api/v1/payments/wave/webhook
# ------------------------------------------------------------------------------
WAVE_API_KEY=wave_sn_prod_your_wave_api_key_here
WAVE_WEBHOOK_SECRET=wave_sn_WHS_your_wave_webhook_secret_here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 6. ORANGE MONEY SENEGAL GATEWAY (UnitechPay Senegal Gateway)
# Documentation: https://pay.unitech.sn/documentation/
# API URL: https://api.unitech.sn/api.php
# ------------------------------------------------------------------------------
UNITECHPAY_API_KEY=your_unitechpay_api_key_here
UNITECHPAY_WEBHOOK_URL=https://api.najastore.sn/api/v1/payments/unitech/webhook
UNITECHPAY_API_URL=https://api.unitech.sn/api.php
UNITECHPAY_ENV=test # 'test' | 'prod'

# ------------------------------------------------------------------------------
# 6. BUSINESS & SENEGAL LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=XOF
COUNTRY_CODE=SN
STORE_NAME="NAJA ROSE STORE"
STORE_PHONE="+221773817191"
STORE_EMAIL="contact@najarosestore.sn"

